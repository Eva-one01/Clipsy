{
  "name": "razor-desktop",
  "productName": "Clipsy",
  "version": "1.4.1",
  "description": "Agenda, tareas, objetivos, alarmas, relojes mundiales y finanzas. Minimalista y privada.",
  "author": "Clipsy",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.felipefranco.razor",
    "productName": "Clipsy",
    "copyright": "© 2026 Clipsy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "license.js",
      "updater.js",
      "voice.js",
      "sync.js",
      "i18n.js",
      "app/**/*",
      "build/icon.png",
      "build/tray.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clipsy",
      "artifactName": "Clipsy-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Clipsy-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Clipsy ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Eva-one01/razor-releases/releases/latest/download"
      }
    ],
    "afterPack": "./scripts/after-pack.js"
  }
}
