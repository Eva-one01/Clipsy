{
  "expo": {
    "name": "Clipsy",
    "slug": "razor",
    "scheme": "razor",
    "version": "1.4.13",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0B",
    "primaryColor": "#2E55E6",
    "description": "Calendario, tareas, objetivos, recordatorios, relojes mundiales y finanzas en una sola app minimalista.",
    "plugins": [
      "expo-router",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supportEmail": "evaone0one@gmail.com"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Clipsy",
      "shortName": "Clipsy",
      "themeColor": "#0A0A0B",
      "backgroundColor": "#0A0A0B"
    }
  }
}
